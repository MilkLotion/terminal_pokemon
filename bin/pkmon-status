#!/usr/bin/env bash
# 펫이 이상하게 보일 때 지금 상태를 확인한다
# 사용: pkmon-status        (이 터미널 기준으로 판정 결과까지 표시)
set -uo pipefail

PROJECT="${PKMON_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
TERM_PID="$PPID"

node - "$PROJECT" "$TERM_PID" <<'NODE'
const [project, termPidArg] = process.argv.slice(2);
const termPid = Number(termPidArg);
// 경로·설정·판정은 전부 공통 모듈에서 온다 — 펫과 같은 코드를 쓴다
const settings = require(`${project}/config.js`);
const state = require(`${project}/lib/state.js`);
const { PATHS, USER_DEFAULTS } = settings;

const age = (at) => (Date.now() / 1000 - (at || 0)).toFixed(1);
const config = settings.load();

console.log(`설정 파일: ${PATHS.config}`);
console.log(`  ${Object.keys(USER_DEFAULTS).map((k) => `${k}=${config[k]}`).join(" ")}`);
console.log(`이 터미널 셸 번호: ${termPid}`);

// 펫과 동일하게 조상 체인으로 내 터미널을 잡는다
const myPids = state.myPidsFor(termPid);
console.log(`내 프로세스 체인: ${[...myPids].join(" ")}`);

const records = state.readWindowRecords(PATHS.windows);
console.log(`\n살아 있는 IDE 창 기록 ${records.length}건 (${PATHS.windows})`);
const mine = state.myRecord(records, myPids);
for (const rec of records) {
  const tag = rec === mine ? "← 내 창" : "";
  console.log(
    `  ${String(rec.windowId).slice(0, 8)}  활성탭=${rec.activeTerminal}  탭들=[${rec.terminals.join(",")}]` +
      `  포커스=${rec.focused}  ${age(rec.at)}초 전  ${tag}`,
  );
}
if (!records.length) console.log("  없음 — VS Code 확장이 없거나 아직 기록 전 (탭 구분이 꺼진다)");

const tab = state.tabAxis(mine, myPids);
console.log(`\n탭 축(내 탭이 활성인가): ${tab === null ? "알 수 없음 — 확장 없음" : tab}`);
// 창 주인은 앱 이름이 아니라 프로세스 조상으로 찾는다 — 여기서도 같은 방법으로 보여 준다
try {
  const { execFileSync } = require("child_process");
  const helper = `${project}/helpers/winbounds`;
  const wins = JSON.parse(execFileSync(helper, { encoding: "utf8" })).windows;
  const chain = state.ancestorPids();
  const owner = state.ownerPidOf(chain, wins);
  const mineWins = wins.filter((w) => w.pid === owner);
  const app = mineWins.length ? mineWins[0].app : "못 찾음";
  console.log(`\n내 터미널을 띄운 프로그램: ${app} (pid ${owner})`);
  console.log(`  그 프로그램의 창 ${mineWins.length}개: ${mineWins.map((w) => w.id).join(", ")}`);
  console.log(`  지금 화면 맨 앞 창: ${wins[0] ? `${wins[0].app} id=${wins[0].id}` : "없음"}`);
} catch {
  console.log("\n창 목록을 읽지 못했다 — helpers/winbounds 가 없거나 이 플랫폼에서 못 쓴다");
}

let files = [];
try {
  const fs = require("fs");
  const path = require("path");
  files = fs
    .readdirSync(PATHS.state)
    .filter((f) => f.endsWith(".json"))
    .map((f) => path.join(PATHS.state, f))
    .sort((a, b) => fs.statSync(b).mtimeMs - fs.statSync(a).mtimeMs);
} catch {
  console.log("\n상태 파일 폴더 없음 — 훅 미설치");
}

console.log(`\n세션 상태 기록 ${files.length}건 (최신순)`);
for (const file of files.slice(0, 10)) {
  let record;
  try {
    record = JSON.parse(require("fs").readFileSync(file, "utf8"));
  } catch {
    continue;
  }
  const isMine = state.stateIsMine(record, myPids, config.runtime.matchCwd);
  console.log(
    `  ${require("path").basename(file).slice(0, 8)}  기록=${record.state}` +
      ` → 지금=${state.resolveState(record)}  ${age(record.at)}초 전  ${isMine ? "← 이 터미널" : "다른 터미널"}`,
  );
}
console.log(`\n이 터미널 펫이 보여야 할 동작: ${state.sessionState(PATHS.state, myPids, config.runtime.matchCwd)}`);

try {
  const out = require("child_process").execFileSync("ps", ["-Ao", "pid=,args="], { encoding: "utf8" });
  const pets = out
    .split("\n")
    .filter((l) => l.includes(project) && !l.includes("--type=") && l.includes("Electron"));
  console.log(`떠 있는 펫 프로세스: ${pets.length}개`);
} catch {
  // 프로세스 조회 실패는 무시
}
NODE
